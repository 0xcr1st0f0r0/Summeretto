# Summeretto 运行环境变量模板
#
# 主要作为 .env 落盘格式参考：CREDENTIAL_PERSIST=1 时 /login 会把 GSA_* 写入卷内 .env，
# 格式与本文件一致。也可作为环境变量注入的取值清单。

# ── 监听 ──
# 监听地址（留空 = 0.0.0.0，容器外可访问）；同机自托管可设 127.0.0.1
HOST=
# 监听端口
PORT=3000

# 入站请求体上限（字节）。多模态大包建议 32MB
MAX_BODY_BYTES=33554432

# ── 密钥（Docker 启动前必填，详见 Docker.md「0. 启动前必填」）──
# ★ 下游调用密钥（x-goog-api-key 头或 ?key=）；留空 = 不校验，任何人都能调用本服务
PROXY_API_KEY=
# /admin/* 管理端点口令（/admin/gpsoauth 网页绑定、/admin/token）；留空 = 端点禁用，网页绑定不可用
ADMIN_KEY=

# ── 谷歌账号凭证 ──
# 网页登录 /login 取得后写回；也可直接注入（Docker 推荐方式，见 docker-compose.yml）。
GSA_EMAIL=
GSA_MASTER_TOKEN=
GSA_ANDROID_ID=

# 静态兜底 token（不自动续期）
ROBIN_AUTH_TOKEN=

# token 供应器轮询 URL（返回 {"token":"ya29..."}）
TOKEN_PROVIDER_URL=

# ── 行为开关 ──
# 媒体渡桥：1 = 开（需 ffmpeg）/ 0 = 关（纯音频回退）
ROBIN_MEDIA_SHIM=1
# 会话隔离：默认 1
ROBIN_ISOLATE_CONVERSATIONS=1
# 空响应自愈重试次数
ROBIN_EMPTY_RETRY=1

# ── 凭证持久化（Docker 配置项，配合 CREDENTIAL_PERSIST=1 使用）──
# /login 把 master token 落盘到此文件；容器启动时由 docker-entrypoint.sh 重新加载。
# 默认指向挂载卷内路径，不要改 unless 你知道自己在做什么。
ROBIN_ENV_FILE=/app/env/.env
